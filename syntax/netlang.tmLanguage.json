{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Net-lang",
  "scopeName": "source.netlang",
  "fileTypes": ["net"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "name": "constant.numeric.duration.netlang", "match": "\\b[0-9]+(?:ms|s|m)\\b" },
    { "name": "constant.numeric.netlang", "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b" },
    { "name": "constant.language.netlang", "match": "\\b(?:true|false|null)\\b" },
    { "name": "keyword.other.network.netlang", "match": "\\b(?:GET|POST|PUT|PATCH|DELETE|HEAD|TCP|UDP|SEND|RECEIVE|TO)\\b" },
    { "name": "keyword.control.netlang", "match": "\\b(?:let|fn|type|return|if|else|while|for|in|match|parallel|break|continue|using)\\b" },
    { "name": "storage.type.netlang", "match": "(?<=:|->)\\s*([a-zA-Z_][a-zA-Z0-9_]*)" },
    { "name": "entity.name.function.netlang", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()" },
    { "name": "keyword.operator.netlang", "match": "=>|->|==|!=|<=|>=|&&|\\|\\||[+*/%=!<>-]" },
    { "name": "punctuation.netlang", "match": "[{}()\\[\\],;:.]" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.netlang", "begin": "//", "end": "$" },
        { "name": "comment.block.netlang", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.netlang",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        { "name": "constant.character.escape.netlang", "match": "\\\\[ntr\"\\\\]" },
        { "name": "invalid.illegal.escape.netlang", "match": "\\\\." }
      ]
    }
  }
}
