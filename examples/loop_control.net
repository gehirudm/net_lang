fn main() {
    let attempts = 0;
    while attempts < 5 {
        attempts = attempts + 1;
        if attempts == 2 {
            continue;
        }
        if attempts == 4 {
            break;
        }
        print("attempt", attempts);
    }

    parallel item in [1, 2, 3] {
        if item == 2 {
            continue;
        }
        print("processed", item);
    }
}
